# GEMINI_API_KEY: Recommended for Gemini AI hook scoring & Google Search Grounding (GTA 6 release tracker).
# Free tier available from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional free-tier key (https://console.groq.com/keys) for ultra-fast
# GPT-OSS-120B hook scoring failover & fast cloud Whisper transcription.
GROQ_API_KEY="MY_GROQ_API_KEY"

# YOUTUBE_API_KEY: Optional. NOT required on Linux PC!
# When omitted, ClipPulse automatically uses yt-dlp for zero-key YouTube search.
YOUTUBE_API_KEY="MY_YOUTUBE_DATA_API_V3_KEY"

# APP_URL: The URL where this applet is hosted (local default: http://localhost:3000).
APP_URL="http://localhost:3000"
